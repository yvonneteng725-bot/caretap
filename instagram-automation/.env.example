# ── Meta / Instagram ─────────────────────────────────────────────────────────
# App secret from Meta App dashboard → App settings → Basic. Used to verify
# the X-Hub-Signature-256 header on incoming webhooks.
META_APP_SECRET=

# Long-lived Page access token with instagram_basic, instagram_manage_comments,
# instagram_manage_messages, pages_manage_metadata permissions.
META_ACCESS_TOKEN=

# The Instagram professional (business/creator) account ID (17841... number).
IG_BUSINESS_ACCOUNT_ID=

# The Facebook Page ID linked to the Instagram account (used for /PAGE_ID/messages).
PAGE_ID=

# Any random string you choose. Must match the Verify Token you enter in the
# Meta App dashboard when registering the webhook callback URL.
VERIFY_TOKEN=

# ── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# The FULL service account JSON key, either as a single-line JSON string or
# base64-encoded (both are accepted). Share the spreadsheet with the service
# account's client_email (Editor access).
GOOGLE_SERVICE_ACCOUNT_KEY=
